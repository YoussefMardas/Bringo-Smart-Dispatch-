# --- Base de données (Supabase / PostgreSQL) ---
# Supabase > Project Settings > Database > Connection string
#
# DATABASE_URL : connexion "pooler" (Transaction, port 6543) utilisée par l'application.
# DIRECT_URL   : connexion directe (port 5432) utilisée par Prisma pour les migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# En local avec un Postgres classique, les deux URL peuvent être identiques :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bringo"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bringo"

# --- Authentification ---
# Secret de signature des sessions (32 caractères minimum).
# Générer : openssl rand -base64 32
AUTH_SECRET="remplacer-par-un-secret-long-et-aleatoire"

# --- Comptes magasins Hyper générés automatiquement ---
# Domaine des adresses e-mail créées (ex. hyper.dar.bouazza@bringo.ma).
ACCOUNT_EMAIL_DOMAIN="bringo.local"

# --- Seed (optionnel) ---
# Mot de passe des comptes de démonstration créés par `npm run db:seed`.
SEED_PASSWORD="ChangeMe123!"
